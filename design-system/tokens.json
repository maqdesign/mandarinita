      "onPrimaryHover": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "secondaryBackground": {
        "$type": "color",
        "$value": "{color.orangeScale.100}"
      },
      "secondaryText": {
        "$type": "color",
        "$value": "{color.orangeScale.800}"
      }
