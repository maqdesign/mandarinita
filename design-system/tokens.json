{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Mandarinita UI Foundations",
  "version": "0.2.0",
  "metadata": {
    "status": "candidate-for-visual-review",
    "scope": "UI only—not registered logo",
    "brandArtImmutable": true
  },
  "color": {
    "brand": {
      "orange": {
        "$type": "color",
        "$value": "#F87209"
      },
      "leafUI": {
        "$type": "color",
